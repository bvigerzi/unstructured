---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<PageLayout title={title} description={description}>
  <Fragment slot="meta">
    <time datetime={pubDate.toISOString()}>
      {pubDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
    {updatedDate && (
      <time class="updated" datetime={updatedDate.toISOString()}>
        Updated {updatedDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    )}
    {tags && tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </Fragment>
  <slot />
</PageLayout>

<style>
  time {
    display: block;
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }

  .updated {
    font-style: italic;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }
</style>
